from PIL import Image, ImageDraw, ImageFont
import numpy as np

# Создаём холст 1200x630
img = Image.new('RGB', (1200, 630), color=(10, 14, 26))
draw = ImageDraw.Draw(img)

# Прямоугольник с градиентом (имитация)
for i in range(630):
    ratio = i / 630
    r = int(10 + (17 - 10) * ratio)
    g = int(14 + (24 - 14) * ratio)
    b = int(26 + (39 - 26) * ratio)
    draw.line([(0, i), (1200, i)], fill=(r, g, b))

# Линия с glow
draw.rectangle([100, 199, 1100, 201], fill=(0, 212, 170))

# Ломаная линия
points = [(100,400), (200,380), (300,390), (400,350), (500,360), 
          (600,320), (700,340), (800,300), (900,310), (1000,280), (1100,290)]
for i in range(len(points)-1):
    draw.line([points[i], points[i+1]], fill=(0, 212, 170), width=4)

# Текст (используйте системный шрифт)
try:
    font_title = ImageFont.truetype("Arial", 72)
    font_sub = ImageFont.truetype("Arial", 28)
    font_tag = ImageFont.truetype("Arial", 20)
    font_btn = ImageFont.truetype("Arial", 14)
except:
    font_title = ImageFont.load_default()
    font_sub = ImageFont.load_default()
    font_tag = ImageFont.load_default()
    font_btn = ImageFont.load_default()

draw.text((600, 160), "Arc FX Blitz", fill="white", anchor="mm", font=font_title)
draw.text((600, 220), "30-second USDC/EURC trading sprint", fill="#64748b", anchor="mm", font=font_sub)
draw.text((600, 520), "ARC NETWORK TESTNET  •  SUB-SECOND FINALITY  •  USDC GAS", 
          fill=(0, 212, 170), anchor="mm", font=font_tag)

# Кнопка
draw.rectangle([520, 560, 680, 596], outline=(0, 212, 170), width=2)
draw.text((600, 578), "PLAY NOW", fill=(0, 212, 170), anchor="mm", font=font_btn)

img.save("arc_fx_blitz.png")
